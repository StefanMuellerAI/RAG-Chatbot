# ---------------------------------------------------------------------------
# Upstash Vector — die Vektor-Datenbank.
# WICHTIG: Der Index MUSS in der Upstash-Konsole mit dem eingebauten
# Embedding-Modell "bge-m3" angelegt werden (mehrsprachig, 1024 Dimensionen).
# Ein Index ohne Embedding-Modell nimmt keinen Rohtext entgegen.
# Bei Verbindung ueber den Vercel-Marketplace werden beide Werte automatisch
# in das Projekt injiziert.
# ---------------------------------------------------------------------------
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ---------------------------------------------------------------------------
# Upstash Redis — Einstellungen (Modell, verschluesselte API-Keys),
# Rate-Limits, Tagesbudget und Dokumenten-Index. Der Free-Tier reicht.
# Ueber den Vercel-Marketplace heissen die Variablen stattdessen
# KV_REST_API_URL / KV_REST_API_TOKEN — beide Namenspaare werden akzeptiert.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Vercel Blob — Ablage der Originaldateien und Metadaten-Sicherung.
# Wird automatisch gesetzt, sobald dem Projekt ein Blob-Store zugeordnet ist.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Zugang
# ADMIN_PASSWORD: Anmeldung des Administrators (Reiter "Administrator").
# Nutzer werden vom Admin per Link eingeladen und setzen eigene Passwoerter;
# sie brauchen keine Umgebungsvariable.
#
# AUTH_SECRET erzeugen mit:  openssl rand -base64 32
# Achtung: AUTH_SECRET signiert Sitzungen UND verschluesselt die im Admin
# hinterlegten API-Keys. Wird es geaendert, muessen sich alle neu anmelden
# und die Keys im Admin neu eingegeben werden.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Modellanbieter — OPTIONAL.
# Anbieter, Modell und API-Key werden im Admin unter "Modell und API-Key"
# hinterlegt. Diese Variablen dienen nur als Rueckfallwert, falls dort kein
# Key gespeichert ist (z. B. fuer die lokale Entwicklung).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
