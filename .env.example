# ===========================================================================
# Clerk — Registrierung, Anmeldung und Nutzerverwaltung
# https://dashboard.clerk.com  ·  Einrichtung: `npx clerk init` oder
# `vercel integration add clerk` (setzt die ersten beiden Werte automatisch)
# ===========================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Aus dem Clerk-Dashboard unter Webhooks. Ohne dieses Geheimnis werden
# Zustellungen abgelehnt — eine offene Webhook-Route waere ein Einfallstor.
# Endpunkt: https://<domain>/api/webhooks/clerk
# Ereignisse: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ===========================================================================
# Neon Postgres — Nutzer, Plaene, Collections, Dokumente, Verlauf, Verbrauch
# `vercel integration add neon` setzt DATABASE_URL automatisch. Fehlt der Name,
# akzeptiert die App auch POSTGRES_URL / POSTGRES_PRISMA_URL (aeltere Neon-
# und Vercel-Postgres-Integrationen).
# Danach einmalig:  npm run db:push && npm run db:seed
# ===========================================================================
DATABASE_URL=

# ===========================================================================
# Vercel AI Gateway — alle Modellaufrufe laufen hierueber.
# Ein Zugang fuer alle Modelle, mit Failover und Kostenzuordnung.
# Auf Vercel ist dieser Schluessel optional: das Gateway authentifiziert
# sich automatisch per OIDC (`VERCEL_OIDC_TOKEN`). Lokal wird der Schluessel
# gebraucht. https://vercel.com/dashboard/ai-gateway
# ===========================================================================
AI_GATEWAY_API_KEY=

# ===========================================================================
# Pinecone — Vektorsuche, ein Namespace je Collection
#
# Der Index MUSS mit eingebautem Embedding-Modell angelegt werden, damit er
# Rohtext annimmt. Das erledigt einmalig:
#
#     npm run pinecone:init
#
# Es entsteht ein Serverless-Index mit "multilingual-e5-large" (mehrsprachig,
# 1024 Dimensionen, Cosine). Ein rein englisches Modell liefert bei deutschen
# Dokumenten deutlich schlechtere Treffer.
# ===========================================================================
PINECONE_API_KEY=
# Optional. Ohne Wert gilt "wissensassistent" — derselbe Name wie bei npm run pinecone:init.
PINECONE_INDEX=wissensassistent
# Nur fuer die Erstanlage des Index relevant.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ===========================================================================
# Upstash Redis — Rate-Limits, Tageskontingente und kurzlebige Caches
# `vercel integration add upstash` setzt beide Werte automatisch.
# Ein Redis-Store unter Storage im Vercel-Dashboard setzt stattdessen
# KV_REST_API_URL / KV_REST_API_TOKEN — die App akzeptiert beide Paare.
#
# PFLICHT fuer Tabellen- und Graph-Sammlungen: Ihre Uploads schreiben je
# Sammlung in eine Datei bzw. einen Graphen und nehmen dafuer eine Sperre in
# Redis (SET NX EX). Ohne Redis bricht die Verarbeitung dieser Typen mit
# klarer Meldung ab, statt ohne Sperre weiterzulaufen.
# ===========================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================================================
# Vercel Blob — Ablage der Originaldateien (privat)
# Wird automatisch gesetzt, sobald dem Projekt ein Blob-Store zugeordnet ist.
# ===========================================================================
BLOB_READ_WRITE_TOKEN=

# ===========================================================================
# FalkorDB — OPTIONAL, nur fuer Graph-Sammlungen (Cypher-Skripte)
# Ohne diese Variable ist der Sammlungstyp "Graph" deaktiviert; Dokumente
# und Tabellen funktionieren unabhaengig davon.
# https://app.falkordb.cloud — Free-Tier: 100 MB, von allen Graphen gemeinsam
# genutzt, ohne TLS.  Format: falkor://benutzer:passwort@host:port
# ===========================================================================
FALKORDB_URL=

# ===========================================================================
# Notbremse: Obergrenze fuer Fragen pro Minute ueber ALLE Nutzer hinweg.
# Greift zusaetzlich zu den Kontingenten der einzelnen Plaene und schuetzt das
# Monatsbudget des Modellanbieters gegen Lastspitzen. Ohne Wert: 5000.
# ===========================================================================
GLOBAL_QUESTIONS_PER_MINUTE=5000

# ===========================================================================
# Aufraeumlauf (stuendlich, siehe vercel.json)
# Zufallswert:  openssl rand -hex 32
# Ohne dieses Geheimnis bleibt /api/cron/aufraeumen gesperrt - eine offene
# Wartungsroute waere ein Hebel, um Kontingente zurueckzusetzen.
# ===========================================================================
CRON_SECRET=
