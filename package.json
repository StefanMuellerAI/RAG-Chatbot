{
  "name": "rag-chatbot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "pinecone:init": "dotenv -e .env.local -- tsx scripts/pinecone-init.ts",
    "pruefe": "npm run pruefe:chunks && npm run pruefe:kontingente && npm run pruefe:env",
    "pruefe:chunks": "tsx scripts/chunk-pruefung.ts",
    "pruefe:kontingente": "tsx scripts/kontingent-pruefung.ts",
    "pruefe:env": "tsx scripts/env-pruefung.ts",
    "migriere:altdaten": "dotenv -e .env.local -- tsx scripts/migriere-altdaten.ts",
    "lasttest": "tsx scripts/lasttest.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.48",
    "@ai-sdk/openai": "^4.0.56",
    "@ai-sdk/react": "^4.0.73",
    "@clerk/localizations": "^4.15.4",
    "@clerk/nextjs": "^7.7.9",
    "@neondatabase/serverless": "^1.1.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "@workflow/next": "^4.1.8",
    "ai": "^7.0.70",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "falkordb": "^6.8.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.2",
    "unpdf": "^1.8.1",
    "workflow": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
